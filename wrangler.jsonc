{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sellerboost-ai",
  "main": "./worker.js",
  "compatibility_date": "2026-09-28",

  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },

  "ai": {
    "binding": "AI"
  }
}
